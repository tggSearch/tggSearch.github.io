---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}{% unless page.sitemap == false or page.url contains '/admin/' or page.url == '/sitemap.xml' %}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
    {% if page.last_modified_at or page.date %}<lastmod>{{ page.last_modified_at | default: page.date | date_to_xmlschema }}</lastmod>{% endif %}
  </url>{% endunless %}{% endfor %}
  {% for post in site.posts %}{% unless post.sitemap == false %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
  </url>{% endunless %}{% endfor %}
</urlset>
